{
  "schema": 1,
  "base": "develop",
  "feature_prefix": "feature/",
  "merge_strategy": "merge",
  "commit_gate": {
    "commands": [
      ["python3", ".githooks/check-staged.py"]
    ]
  },
  "readiness_gate": {
    "commands": [
      "./scripts/verify"
    ]
  },
  "integration_gate": {
    "commands": []
  },
  "required_ci": ["lifecycle-verify"],
  "required_review": false,
  "special_authorization": [
    "database",
    "docker",
    "live_provider",
    "destructive_cleanup"
  ]
}
